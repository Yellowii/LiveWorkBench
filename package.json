{
  "name": "liveworkbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=4 tests/*.test.js",
    "setup:parser": "node tools/setup-parser.mjs",
    "setup:websource": "node tools/setup-websource.mjs",
    "setup:wss-signer": "node tools/setup-wss-signer.mjs",
    "setup:browser": "node tools/setup-browser.mjs",
    "check:public": "node tools/check-public.mjs",
    "build:capture": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-capture.ps1"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "acorn-walk": "8.3.4",
    "https-proxy-agent": "7.0.6",
    "protobufjs": "7.5.4",
    "socks-proxy-agent": "8.0.5",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "playwright-core": "1.58.2"
  }
}
